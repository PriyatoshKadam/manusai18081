DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-a-different-random-secret
PG_SSL=true
# Production should verify the PostgreSQL certificate. Supply the provider CA when available.
PG_SSL_REJECT_UNAUTHORIZED=true
# Render may require a narrowly scoped compatibility exception for its self-signed chain.
# Set both flags only for a Render DATABASE_URL when PG_CA_CERT is unavailable.
# PG_SSL_REJECT_UNAUTHORIZED=false
# ALLOW_RENDER_SELF_SIGNED_TLS=true
# Optional CA bundle; preferred over the compatibility exception.
# PG_CA_CERT_PATH=/run/secrets/render-postgres-ca.pem
# Generic development-only escape hatch; never enable this in production.
# ALLOW_INSECURE_DB_TLS=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set this when the monitor service is hosted separately from the dashboard.
# NEXT_PUBLIC_MONITOR_ORIGIN=https://monitoring-0jsu.onrender.com
# Optional defense-in-depth check; leave false/unset for browser collectors because Origin/Referer can vary.
# TELEMETRY_STRICT_ORIGIN=false
# Google Cloud OAuth web application credentials for GTM Connect.
# The redirect URI must exactly match the URI registered in Google Cloud.
GTM_CLIENT_ID=replace-with-google-oauth-client-id
GTM_CLIENT_SECRET=replace-with-google-oauth-client-secret
GTM_REDIRECT_URI=http://localhost:3000/api/gtm/callback
NODE_ENV=development
ALLOW_INSECURE_DEV_AUTH=true

# Optional incident delivery channels.
# RESEND_API_KEY=replace-with-resend-api-key
# ALERT_FROM_EMAIL=alerts@example.com
# CRON_SECRET=replace-with-a-long-random-job-secret
