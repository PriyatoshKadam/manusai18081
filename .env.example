DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-a-different-random-secret
PG_SSL=true
# Optional CA bundle; leave unset when the host uses a trusted public CA.
# PG_CA_CERT_PATH=/run/secrets/render-postgres-ca.pem
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set this when the monitor service is hosted separately from the dashboard.
# NEXT_PUBLIC_MONITOR_ORIGIN=https://monitoring-0jsu.onrender.com
NODE_ENV=development
ALLOW_INSECURE_DEV_AUTH=true
