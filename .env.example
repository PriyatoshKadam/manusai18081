DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-a-different-random-secret
PG_SSL=true
# Optional CA bundle; when provided, certificate verification stays enabled.
# PG_CA_CERT_PATH=/run/secrets/render-postgres-ca.pem
# Override only when required by the database provider. Render Postgres without a CA
# uses encrypted TLS with hostname-scoped certificate-chain tolerance by default.
# PG_SSL_REJECT_UNAUTHORIZED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set this when the monitor service is hosted separately from the dashboard.
# NEXT_PUBLIC_MONITOR_ORIGIN=https://monitoring-0jsu.onrender.com
# Google Cloud OAuth web application credentials for GTM Connect.
# The redirect URI must exactly match the URI registered in Google Cloud.
GTM_CLIENT_ID=replace-with-google-oauth-client-id
GTM_CLIENT_SECRET=replace-with-google-oauth-client-secret
GTM_REDIRECT_URI=http://localhost:3000/api/gtm/callback
NODE_ENV=development
ALLOW_INSECURE_DEV_AUTH=true
